# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Explicitly text
*.js    text
*.json  text
*.html  text
*.css   text
*.md    text
*.yml   text
*.yaml  text
*.txt   text
.gitignore     text
.gitattributes text

# Binary (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.asar  binary
